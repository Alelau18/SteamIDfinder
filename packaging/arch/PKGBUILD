# Self-build package for Arch Linux, tracking the latest commit on main.
# Not published to the AUR. Build and install with:
#   cd packaging/arch && makepkg -si
pkgname=steamidfinder-git
_repo=SteamIDfinder
pkgver=0.1.0
pkgrel=1
pkgdesc='Turn any Steam ID into a Steam profile link, with name, avatar and name history'
arch=('x86_64' 'aarch64')
url='https://github.com/Alelau18/SteamIDfinder'
license=('MIT')
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'libglvnd' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'git')
optdepends=(
  'libx11: X11 session support'
  'libxcursor: X11 session support'
  'libxi: X11 session support'
  'libxrandr: X11 session support'
  'noto-fonts-cjk: Chinese, Japanese and Korean profile names'
)
provides=('steamidfinder')
conflicts=('steamidfinder')
source=("git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_repo"
  (
    set -o pipefail
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' ||
      printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
  )
}

prepare() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_repo"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "$_repo"
  install -Dm755 target/release/steamidfinder -t "$pkgdir/usr/bin/"
  install -Dm644 assets/steamidfinder.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 assets/steamidfinder.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 assets/icon-256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/steamidfinder.png"
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$pkgname/"
  install -Dm644 README.md extras/noctalia/steamidfinder.toml -t "$pkgdir/usr/share/doc/$pkgname/"
}
